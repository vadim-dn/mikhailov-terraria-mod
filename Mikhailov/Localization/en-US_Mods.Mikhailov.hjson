Items: {
	ManholeCover: {
		DisplayName: Manhole Cover
		Tooltip:
			'''
			Left click: a blazing-fast throw that vanishes after five wall ricochets
			Hold right click: charge a homing throw that strikes multiple targets
			Charged hits pull nearby enemies toward the impact
			With no targets, the charged cover ricochets off walls five times
			'''
	}

	MikhailovRoot: {
		DisplayName: Mikhailov's Root
		Tooltip:
			'''
			Left click: a three-shot combo of rapid green pulses
			Right click: a wide wave that knocks enemies back and releases homing leaves
			Uses no mana
			'''
	}

