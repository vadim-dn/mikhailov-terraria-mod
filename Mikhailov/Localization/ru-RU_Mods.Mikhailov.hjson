Items: {
	ManholeCover: {
		DisplayName: Крышка от люка
		Tooltip:
			'''
			ЛКМ: стремительный бросок, исчезающий после пяти рикошетов от стен
			Удерживай ПКМ: заряженный самонаводящийся бросок по нескольким целям
			Попадания заряженной крышки притягивают ближайших врагов
			Если целей нет, заряженная крышка рикошетит от стен пять раз
			'''
	}

	MikhailovRoot: {
		DisplayName: Корень Михайлова
		Tooltip:
			'''
			ЛКМ: серия из трёх быстрых зелёных импульсов
			ПКМ: широкая волна, отбрасывающая врагов и выпускающая самонаводящиеся листья
			Не расходует ману
			'''
	}

	Screwdriver: {
		Tooltip:
			'''
			ЛКМ: ускоряющиеся спиральные шурупы
			Удерживай ПКМ: турель с электрической цепью
			'''
		DisplayName: Шуруповёрт
	}

	RailBorer: {
		Tooltip:
			'''
			ЛКМ: тяжёлый рельс с сильной отдачей
			Удерживай ПКМ: заряд сине-белого взрывного луча
			'''
		DisplayName: Рельсобой
	}

	MikhailovTear: {
		Tooltip:
			'''
			ЛКМ: бутылка выпускает самонаводящегося огненного змея
			ПКМ: призывает живого огненного духа; повторный бросок усиливает его
			'''
		DisplayName: Бутылка «Михайловская Слеза»
	}

	MikhailovskyAK: {
		Tooltip:
			'''
			ЛКМ: автоматический огонь с трассерами
			ПКМ: трёхцветная магическая очередь со взрывом
			'''
		DisplayName: Михайловский АК
	}

	HeatingPipe: {
		Tooltip:
			'''
			ЛКМ: быстрое комбо с водяными выплесками
			Удерживай ПКМ: напорная струя воды
			'''
		DisplayName: Труба отопления
	}

	GopArrow: {
		Tooltip:
			'''
			ЛКМ: ядовитая стрела, разделяющаяся на осколки
			Удерживай ПКМ: многоцветный заряженный выстрел
			'''
		DisplayName: Гоп-Стрела
	}

	ColdTecLight: {
		DisplayName: Холодный свет ТЭЦ
		Tooltip:
			'''
			ЛКМ: импульс отражается от стен и усиливается до четырёх раз
			ПКМ: магнитная призма притягивает и преломляет импульсы
			Попадания замедляют врагов
			Не расходует ману
			'''
	}

	PudgeMask: {
		DisplayName: Маска Pudge
		Tooltip: Часть комплекта Pudge
		SetBonus: Открывает способности Hook [Z], Rot [X] и Dismember [C]
	}

	PudgeBody: {
		DisplayName: Тело Pudge
		Tooltip: Часть комплекта Pudge
	}

	PudgeLegs: {
		DisplayName: Поножи Pudge
		Tooltip: Часть комплекта Pudge
	}
}

